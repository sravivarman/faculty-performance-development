	keywords = {Energy utilization; Housing; Solar energy; Solar power generation; Sustainable building; Zero energy buildings; Building energy; Building energy optimization tool tool; Building integrated photovoltaic; Energy; Energy conservation technique; Energy optimization; Energy system design; Optimization tools; Solar energy system design; Solar energy systems; Zero energies; Green buildings},
