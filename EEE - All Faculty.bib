	title = {A hybrid predictive and uncertainty-aware framework for renewable hydrogen system efficiency assessment and sustainable energy planning},
	year = {2026},
	journal = {Scientific Reports},
	volume = {16},
	number = {1},
	pages = {},
	doi = {10.1038/s41598-026-74915-4},
	url = {https://www.scopus.com/pages/publications/105054495701?origin=resultslist},
	affiliations = {Department of Electronics and Communication Engineering, GLA University, Mathura, 281406, India; Department of Electrical and Electronics Engineering, Vardhaman College of Engineering Hyderabad, Telangana, Hyderabad, India; Faculty of Engineering, Hourani Center for Applied Scientific Research, Al-Ahliyya Amman University, Amman, Jordan; Department of Electrical and Electronics Engineering, School of Engineering and Technology, JAIN (Deemed to be University), Karnataka, Bangalore, India; Management and Science University, Selangor, Shah Alam, Malaysia; Department of Electrical and Electronics Engineering, Siksha ’O’ Anusandhan (Deemed to be University), Odisha, Bhubaneswar, 751030, India; Department of Electrical and Electronics Engineering, Sathyabama Institute of Science and Technology, Tamil Nadu, Chennai, India; Department of Electronics and Communication Engineering, Chandigarh University, Punjab, Mohali, India},
	abstract = {Renewable hydrogen is emerging as a critical element in the transition toward low-carbon and sustainable energy systems; however, accurately evaluating system efficiency remains challenging due to complex, nonlinear interactions among technical and environmental factors. This study proposes a hybrid predictive and uncertainty-aware framework for assessing renewable hydrogen system efficiency and supporting sustainable energy planning. The framework integrates Elastic Net and Extra Trees regression models enhanced through meta-heuristic optimization using Sparrow Search and Firefly algorithms to improve predictive performance. Recursive Feature Elimination is applied to identify the most influential variables governing system behavior, while Dempster–Shafer Theory is incorporated to model uncertainty and construct a robust ensemble prediction strategy. The proposed approach is evaluated using a dataset of 2,535 renewable hydrogen system records with spatial attributes derived from documented geographical coordinates. Experimental results demonstrate notable improvements in predictive accuracy, with a 12% increase in R² and a 15% reduction in MAE compared to baseline approaches. Sensitivity analysis indicates that photovoltaic power generation and electrolysis efficiency are the most influential factors affecting hydrogen system performance. Beyond improved prediction accuracy, the framework provides interpretable insights that can support infrastructure development, investment planning, and energy policy design. The proposed methodology demonstrates how hybrid predictive modeling combined with uncertainty quantification can enhance decision-making processes in renewable hydrogen systems and contribute to more reliable low-carbon energy transitions. © The Author(s) 2026.},
	author_keywords = {Energy Systems; Optimization Algorithms; Predictive Modeling; Renewable Hydrogen; Sustainable Energy Planning; Uncertainty Quantification},
	correspondence_address = {A.D. Tellapati; Department of Electrical and Electronics Engineering, Vardhaman College of Engineering Hyderabad, Hyderabad, Telangana, India; email: anuradha1011@vardhaman.org},
	publisher = {Nature Research},
	issn = {20452322},
	language = {English},
	abbrev_source_title = {Sci. Rep.},
	type = {Article},
	publication_stage = {Final},
