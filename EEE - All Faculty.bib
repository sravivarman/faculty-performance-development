	title = {COBAD-FIR: a hybrid coati-badger optimization framework for power-efficient FIR coefficient enhancement in VLSI systems},
	year = {2026},
	journal = {Engineering Research Express},
	volume = {8},
	number = {10},
	pages = {},
	doi = {10.1088/2631-8695/ae6999},
	url = {https://www.scopus.com/pages/publications/105039271406?origin=resultslist},
	affiliations = {Department of Electronics Engineering (VLSI Design and Technology), RMK Engineering College, Kavaraipettai, Tamilnadu, Chennai, 601206, India; Department of Electrical and Electronics Engineering, Vardhaman College of Engineering, Shamshabad, Telangana, 501218, India; Department of Electrical and Electronics Engineering, Chennai Institute of Technology, Tamilnadu, Chennai, India; Department of Information Technology Management, St Francis College, New York, Brooklyn, 11201-9902, NY, United States; Centre of Research Impact and Outcome, Chitkara University, Punjab, Rajpura, 140401, India; Center for innovation and inclusive research, Sharda University, Uttar Pradesh, Greater Noida, India},
	abstract = {Among the fundamental requirements of VLSI-based digital signal processing systems is the improvement of filtering coefficients, which is directly connected with accuracy of frequency response, numerical stability, switching activity, and power consumption in fixed-point-based considerations. Because of this, it is of the utmost importance to design the optimization strategies of coefficients that can be jointly applied to the signal fidelity and VLSI criteria. To address such problems, the present paper proposes a COatiBAdger Hybrid Adaptive Design (COBAD) model of the FIR coefficient enhancement. In this paper, a new hybrid algorithm, the COBAD-FIR algorithm, coati optimization algorithm and honey badger algorithm to optimize the FIR filter coefficients are proposed, but with the objective of providing signal as well as VLSI efficiency. Its key contribution is a quantization- and switching-aware multi-objective fitness function that makes it possible to design FIRs with low-power and hardware-friendly designs. The introduction of quantization-sensitive and switching-activity-sensitive objectives in the optimization problem, and the ensuing coefficient generation, is one of novelty, and can now be software-implemented in hardware-efficient ways, and implemented macroscopically in VLSI technology. The performance of the suggested method is warranted by simulation. A FIR filter based on COBAD has a passband ripple of 0.028dB, stopband attenuation of 57 dB, quantization error of 0.006 and index of reduced switching activities of 0.32 that are even better than eight of the optimization methods available. © 2026 IOP Publishing Ltd. All rights, including for text and data mining, AI training, and similar technologies, are reserved. This article is available under the terms of the https://publishingsupport.iopscience.iop.org/iop-standard/v1.},
	author_keywords = {coefficient enhancement; FIR filter; optimization; signal processing; switching activity; VLSI systems},
	keywords = {Computer hardware; Computer software; Data mining; Digital signal processing; Integrated circuit design; Minimization of switching nets; Quantization (signal); VLSI circuits; Adaptive designs; Coefficient enhancement; Digital signal processing systems; Optimisations; Optimization framework; Power efficient; Quantisation; Signal-processing; Switching activities; VLSI system; FIR filters},
	correspondence_address = {K. S; Department of Electronics Engineering (VLSI Design and Technology), RMK Engineering College, Chennai, Kavaraipettai, Tamilnadu, 601206, India; email: karunakaraneev@gmail.com},
	publisher = {Institute of Physics},
	issn = {26318695},
	language = {English},
	abbrev_source_title = {Eng. Res. Exp.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Bronze Open Access}
}

