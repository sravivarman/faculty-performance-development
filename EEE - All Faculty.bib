@CONFERENCE{Krishna2025,
	author = {Krishna, P. V. Rama and Somasankarappa, Chidige and Srikavitha, P. and Lakshmi, C. Santhana and Dangi, Sarishma and Padmavathy, R. and Reddy, S. Vinod and Kakinatla, Suresh},
	title = {BWKA Based MPPT of a PV System under Partial Shading Conditions for Charging the Battery Bank},
	year = {2025},
	journal = {2025 IEEE 2nd International Conference on Information Technology, Electronics and Intelligent Communication Systems, ICITEICS 2025},
	pages = {},
	doi = {10.1109/ICITEICS64870.2025.11341006},
	url = {https://www.scopus.com/pages/publications/105033237699?origin=resultslist},
	affiliations = {GITAM (Deemed to Be University), Department of Electrical Electronics and Communication Engineering, Telangana, Hyderabad, India; CMR College of Engineering and Technology, Telangana, Hyderabad, India; Aditya University, Department of Electrical and Electronics Engineering, Andhra Pradesh, Surampallem, India; Sona College of Technology, Department of EEE, Tamil Nadu, Salem, India; Graphic Era Deemed to Be University, Department of Computer Science and Engineering, Dehradun, India; New Prince Shri Bhavani College of Engineering and Technology, Department of ECE, Tamil Nadu, Chennai, India; Vardhaman College of Engineering, EEE, Telangana, Hyderabad, India; CPGC Pvt. Ltd and ERG Foundation, Andhra Pradesh, Visakhapatnam, India},
	abstract = {Batteries are participated in many power system networks and our daily life. Charging the battery banks through Photovoltaic (PV) systems is an interesting research topic due to its numerous applications. Usually a bidirectional flow of power must be facilitate between the network and the battery bank. Hence a bidirectional device is facilitated between the dc-link and battery where dc-link is connected by PV system and load point. The PV system is consisting of multiple PV modules, hence, there is a chance to receive various solar irradiances by different modules. Hence, it will lead to the partial shading condition (PSC) where PV system can exhibits several maximum power points (MPPs). Under this operation, traditional maximum power point tracking (MPPT) techniques are unable to track exact power related to global maximum power location. Therefore, it is essential to integrate an effective optimization technique with traditional MPPT algorithms to boost system efficiency and improve overall system performance. A black winged kite algorithm (BWKA) is proposed in this research work to identify the location of global MPP during PSC of the PV system. The performance of the presented technique is compared with modified invasive weed optimization (MIWO), modified grey wolf optimization (MGWO) and whale optimization algorithm (WOA). Further, the control of bidirectional device of the battery is integrated with proposed BWKA method to work the same converter as a MPPT device of the PV system. Hence, this configuration can avoid an extra converter for the purpose of MPPT device. The system is designed using the Hardware-in-the-Loop (HIL) methodology on the OPAL-RT platform to showcase a variety of results. © 2025 IEEE.},
	author_keywords = {Battery; Bidirectional converter; Black winged kite algorithm; MPPT; Partial shading; PV system},
	keywords = {Charging (batteries); Industrial electronics; Optimization; Secondary batteries; Solar cells; Battery; Battery banks; Bidirectional converter; Black winged kite algorithm; Condition; Dc-link; Maximum power point; Maximum Power Point Tracking; Partial shading; Photovoltaic systems; Maximum power point trackers},
	correspondence_address = {S. Kakinatla; CPGC Pvt. Ltd and ERG Foundation, Visakhapatnam, Andhra Pradesh, India; email: suresh@erg.org.in},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833150784-8},
	language = {English},
