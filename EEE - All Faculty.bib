	title = {Induction Motor Driven Grid Connected Water Pumping System Powered by Wind-PV-Battery-Diesel Hybrid Generation},
	year = {2025},
	journal = {1st International Conference on Advances in Computer Science, Electrical, Electronics, and Communication Technologies, CE2CT 2025},
	pages = {1082 - 1087},
	doi = {10.1109/CE2CT64011.2025.10939647},
	url = {https://www.scopus.com/pages/publications/105002703456?origin=resultslist},
	affiliations = {Chaitanya Bharathi Institute of Technology, Department of EEE, Telangana, Hyderabad, India; CPGC Pvt. Ltd, ERG Foundation, Andhra Pradesh, Visakhapatnam, India; Maharani Cluster University, Department of Electronics, Karnataka, Bangalore, India; Mahatma Gandhi Institute of Technology, Department of EEE, Telangana, Hyderabad, India; New Prince Shri Bhavani College of Engineering and Technology, Department of CSE, Tamil Nadu, Chennai, India; Vardhaman College of Engineering, Telangana, Hyderabad, India},
	abstract = {Aqua farms require an uninterrupted power supply to operate various induction motors and maintain optimal oxygen level. Numerous regions often face power outages and rely solely on single-phase electricity supply. Consequently, the conversion from 1-ph to 3-ph power is essential for running motors and utilizing diesel generators when there is a power failure. Regrettably, the excessive use of diesel fuel presents difficulties in aquaculture. Integrating a wing generation and photovoltaic (PV) system into the aqua farm can be advantageous in minimizing diesel consumption. Solar and Wind power, though, rely on nature as well as erratic. Consequently, the system also incorporates a compact battery. It is essential to have a well-functioning energy management approach in place in order to enhance the efficiency and cost-effectiveness of the entire system. Excess power produced by the wind and PV systems can be sent to the 1-ph grid. Sliding mode controllers based DC converters are used to ensure a stable DC-link voltage. The power supply via grid is transformed into DC, then subsequently amplified to the specified voltage level in order to generate an ample three-phase AC voltage via an inverter. This resulting output from the inverter is suitable for running motor-pump units for water distribution and three-phase induction motors for oxygen circulation within the ponds. The main aim of the proposed strategy is to reduce motor torque fluctuations, ultimately improving the lifespan of system parts and decreasing energy usage. In order to accomplish this task, a speed sensorless direct torque control is designed by using T-S Fuzzy controller through the use of a three-phase inverter to drive the induction motor. The effectiveness of the proposed methodology is extensively assessed through the utilization of the MATLAB Simulink platform, with the outcomes being showcased to confirm its efficiency. © 2025 IEEE.},
	author_keywords = {Induction motor; PV; Sliding mode controller; T-S Fuzzy; Water pumping system; Wind},
	keywords = {Activated silica treatment; Asynchronous generators; Automotive batteries; Biological water treatment; Fluoridation; Nuclear batteries; Sensorless control; Traction motors; Uninterruptible power systems; Wastewater treatment; Water well pumps; Aqua farms; Grid-connected; Hybrid generation; Inductions motors; Photovoltaic systems; Photovoltaics; Power; Sliding mode controller; T-S fuzzy; Water pumping systems; Aquaculture},
	correspondence_address = {K.B. Prakash; CPGC Pvt. Ltd and ERG Foundation, Visakhapatnam, Andhra Pradesh, India; email: kandibhanu@erg.org.in},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833151857-8},
	language = {English},
	abbrev_source_title = {Int. Conf. Adv. Comput. Sci., Electr., Electron., Commun. Technol., CE2CT},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
