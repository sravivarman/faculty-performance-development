@ARTICLE{Soma2024,
	author = {Soma, Keerthi Sonam and Balamurugan, R. and Natarajan, Karuppiah},
	title = {Performance improvement of PV systems during dynamic partial shading conditions using optimization algorithms},
	year = {2024},
	journal = {Transactions on Energy Systems and Engineering Applications},
	volume = {5},
	number = {1},
	pages = {},
	doi = {10.32397/tesea.vol5.n1.557},
	url = {https://www.scopus.com/pages/publications/85193687578?origin=resultslist},
	affiliations = {Department of Electrical Engineering, Annamalai University, Tamilnadu, Annamalai Nagar, 608 002, India; Department of Electrical and Electronics Engineering, Vardhaman College of Engineering, Telangana, Hyderabad, 501 218, India},
	abstract = {PV power plants encounter varying levels of irradiance, temperature fluctuations, and partial shading because of the differences in sunlight conditions. Partial shading can cause an increase in the power loss, leading to a reduction in efficiency. Maximum Power Point Tracking (MPPT) is of utmost importance in the functioning of photovoltaic (PV) systems for electricity generation because it is indispensable for maximizing power extraction from PV modules, thereby increasing the overall power output. In situations where partial shading is present, the utilization of MPPT algorithms to achieve maximum power output becomes complex because of the existence of multiple distinct peak power points, each having a unique local optimum. To overcome this issue, a method is proposed that uses Darts Game Optimization (DGO), a game-based optimization process, to efficiently determine and extract the maximum power from various local optimal peaks. A population-based optimization method known as the Darts Game Optimization algorithm exists. In this approach, the optimization process begins by creating a population of random players. Then, the algorithm iteratively updates and improves the population to search for the best player or solution. In this study, the DGO algorithm was applied to the MPPT process for voltage optimization in the PV procedure. The DC-DC converter is utilized to capture the maximum available power, and the findings demonstrate that the DGO algorithm efficiently identifies the global maximum, resulting in accelerated convergence, reduced settling time, and minimized power oscillation. Through simulations, the feasibility and effectiveness of the DGO centered MPPT approach was confirmed and compared with MPPT algorithms relying on perturb and observe (P&O) and Particle Swarm Optimization (PSO). The simulation results offer compelling evidence that the DGO algorithm, as proposed in this study, proficiently traces the global maximum, thereby substantiating its practicality and efficiency. © 2024 by the authors.},
	correspondence_address = {K.S. Soma; Department of Electrical Engineering, Annamalai University, Annamalai Nagar, Tamilnadu, 608 002, India; email: keerthi06210@gmail.com; R. Balamurugan; Department of Electrical Engineering, Annamalai University, Annamalai Nagar, Tamilnadu, 608 002, India; email: bala_aucdm@yahoo.com; K. Natarajan; Department of Electrical and Electronics Engineering, Vardhaman College of Engineering, Hyderabad, Telangana, 501 218, India; email: natarajankaruppiah@gmail.com},
	publisher = {Universidad Tecnologica de Bolivar},
	issn = {27450120},
	language = {English},
	abbrev_source_title = {Trans. Energy. Syst. Eng. Appl.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access; Gold Open Access; Green Open Access}
}

