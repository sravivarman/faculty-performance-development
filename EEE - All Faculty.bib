	title = {PIC controlled hardware model realization for frequency regulation in power plants},
	year = {2021},
	journal = {Proceedings of the 3rd International Conference on Intelligent Communication Technologies and Virtual Mobile Networks, ICICV 2021},
	pages = {528 - 534},
	doi = {10.1109/ICICV50876.2021.9388627},
	url = {https://www.scopus.com/pages/publications/85104397980?origin=resultslist},
	affiliations = {Vardhaman College of Engineering, Department of EEE, Hyderabad, Telangana, India; Sri Sivasubramaniya Nadar College of Engineering, Department of EEE, Kalavakkam, Chennai, India; Vel Tech Multi Tech Dr. Rangarajan Dr. Sakunthala Engineering College, Department of EEE, Avadi, Chennai, India},
	abstract = {Frequency regulation in power plants is the need of the hour to maintain power system reliability. Generation and load demand are continuously monitored and the governor system of turbine is operated to keep the frequency within the desirable limit. In the proposed scheme, a hardware model is realized which consists of separate control for real power and reactive power to maintain a constant frequency. In the existing power plants, complete opening and closing of valves are done when the frequency exceeds the tolerance limit. This results in huge stresses on turbine blades. The proposed valve control mitigates the turbine blade stresses by partially opening and closing the valves even when there is a slight change in frequency. The proposed frequency regulation eliminates the steady state error through integral action. The complexity of gate control circuitry in the existing system for reactive power control is also eliminated by a separate reactive power control circuitry comprising of an operational amplifier and a current amplifier. The proposed system performs better than the existing method in thermal power plants. © 2021 IEEE.},
	author_keywords = {Current calibration; Frequency regulation; Pressure Calibration; PROTEUS; Reactive power control; Real power control; Voltage calibration},
	keywords = {Cellular radio systems; Mobile telecommunication systems; Operational amplifiers; Plant shutdowns; Reactive power; Thermoelectric power plants; Turbine components; Turbomachine blades; Wireless networks; Constant frequency; Current amplifier; Existing systems; Frequency regulations; Power system reliability; Steady state errors; Thermal power plants; Tolerance limits; Power control},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {978-073811183-4},
	language = {English},
	abbrev_source_title = {Proc. Int. Conf. Intell. Commun. Technol. Virtual Mob. Networks, ICICV},
