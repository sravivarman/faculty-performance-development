	keywords = {Boost converter; Global optimization; Particle swarm optimization (PSO); Solar energy; Solar panels; BOOST converter; Dart game optimization; Optimisations; Optimizers; Partial shading; Particle swarm; Particle swarm optimization; Perturb and observe; Swarm optimization; Maximum power point trackers},
