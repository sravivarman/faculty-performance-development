	pages = {},
	doi = {10.1109/EPREC66546.2026.11411962},
	url = {https://www.scopus.com/pages/publications/105036393290?origin=resultslist},
	affiliations = {Vignana Bharathi Institute of Technology, Department of EEE, Telangana, Hyderabad, India; Siddhartha Academy of Higher Education (Deemed to Be University), VR Siddhartha School of Engineering, Department of EIE, Andhra Pradesh, Vijayawada, India; Centurion University, Dept. Electrical and Electronics Engineering, Orissa, Bhubaneswar, India; Sona College of Technology, Department of Electrical and Electronics Engineering, Tamil Nadu, Salem, India; Graphic Era Deemed to Be University, Department of Computer Science and Engineering, Dehradun, India; New Prince Shri Bhavani College of Engineering and Technology, Department of CSE, Tamil Nadu, Chennai, India; Vardhaman College of Engineering, Department of EEE, Telangana, Hyderabad, India; New Horizon College of Engineering, Department of ECE, Karnataka, Bangalore, India; CPGC Pvt. Ltd, ERG Foundation, Andhra Pradesh, Visakhapatnam, India},
	abstract = {Various renewable energy sources based power supply systems are commonly used for multiple applications. Solar energy for power production especially through PV systems is gaining attention recently. However, there is no guarantee of receiving same irradiance by all PV modules or panels connected in PV system. Under these circumstances, PV systems are unable to produce its maximum capable of power by using conventional maximum power point tracking (MPPT) techniques. Hence, efficient optimization methods must be required during the conditions of no uniform solar irradiances which called as Partial Shading conditions (PSCs). Hence, a Multi-Strategy Improved Dung Beetle Optimization Algorithm (MSI-DBOA) is developed in this paper to make MPPT method effectively for working under PSCs. The proposed method is effectively applied on a boost converter to make it as a MPPT device. Six distinguish PSCs are considered throughout this paper for making an effective analysis on proposed methodology. Various results are compared among proposed method and four existing optimization methods recently. The effectiveness of the proposed method is demonstrated and explains how it is required in this field of PV MPPT methodology. Hardware in the Loop (HIL) concept is implemented by using OPAL-RT technologies to present various responses. © 2026 IEEE.},
	author_keywords = {Dung Beetle Optimization; Hardware in the Loop; Maximum Power Point Tracking; Partial Shading Condition; PV System},
	keywords = {Ecology; Electric power systems; Natural resources; Optimization; Solar energy; Solar irradiance; Solar power generation; Condition; Dung beetle optimization; Dung beetles; Hardware in the loops; Maximum Power Point Tracking; Optimisations; Optimization algorithms; Partial shading; Partial shading condition; PV system; Maximum power point trackers},
	correspondence_address = {G.P. Rao; Vignana Bharathi Institute of Technology, Department of EEE, Hyderabad, Telangana, India; email: g.poornachandrarao@gmail.com; K.B. Prakash; CPGC Pvt. Ltd, ERG Foundation, Visakhapatnam, Andhra Pradesh, India; email: kandibhanu@erg.org.in},
