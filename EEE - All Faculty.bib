	keywords = {artificial intelligence; artificial neural network; energy storage; equipment; filter; performance assessment; photovoltaic system; solar power},
	correspondence_address = {L. Mihet-Popa; Faculty of Information Technology, Engineering and Economics, Oestfold University College, Halden, 1757, Norway; email: lucian.mihet@hiof.no},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
