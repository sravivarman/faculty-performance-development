	keywords = {Electric power system control; Genetic algorithms; Optimal control systems; Power quality; Power systems computer aided design; Swarm intelligence; Estimation problem; Optimal controls; Optimal design; Performance; Power; Power system state estimation; Strategy optimization; Total harmonic distortions; Unified power quality conditioners; War strategy optimization; State estimation},
