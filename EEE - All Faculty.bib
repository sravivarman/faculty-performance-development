	title = {Current issues and future challenges regarding electric vehicles' fast charging and its impact on grid power quality in the grid},
	year = {2024},
	journal = {Renewable Energy for Plug-In Electric Vehicles: Challenges, Approaches, and Solutions for Grid Integration},
	pages = {27 - 44},
	doi = {10.1016/B978-0-443-28955-2.00003-2},
