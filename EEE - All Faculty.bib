	affiliations = {Vardhaman College of Engineering, Department of EEE, Telangana, Hyderabad, India},
	abstract = {Due to the various climatic circumstances, the generation of electricity from solar photovoltaic (PV) systems is highly complicated. The main problem with a large-scale PV system is to locate and identify the solar PV defect. In order to improve protectionand maintenance, the solar PV system needs automatic fault detection and localization. In this study, an approach for the detection of faults is provided, which compares the residual faults with the threshold value. The primary aim of the suggested approach is to find the flaws between lines within a solar rooftop string.Different line-line fault instances are investigated and confirmed using MATLAB/Simulink and hardware, i.e., practically employing 3x3 solar panels, to confirm the effectiveness of the suggested technique. The experiment is run initially with fixed-size PV arrays and subsequently expanded to include PV arrays of various sizes. The findings demonstrate that the suggested technique is more effective and accurate in finding and locating flaws. © 2023 IEEE.},
	author_keywords = {Fault location; PV protection; PV system; Solar Rooftop panel; String monitoring},
	keywords = {Fault detection; Location; Solar concentrators; Solar power generation; Large-scale photovoltaics; Location of fault; Photovoltaic arrays; Photovoltaic protection; Photovoltaic systems; Photovoltaics; Solar photovoltaic system; Solar photovoltaics; Solar rooftop panel; String monitoring; Solar panels},
	correspondence_address = {M. Patil; Vardhaman College of Engineering, Department of EEE, Hyderabad, Telangana, India; email: mounica.p@vardhaman.org},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-835034800-2},
	language = {English},
	abbrev_source_title = {Int. Conf. Smart Technol. Syst. for Next Gener. Comput., ICSTSN},
