	year = {2025},
	journal = {Proceedings of the 6th International Conference on Smart Electronics and Communication, ICOSEC 2025},
	pages = {12 - 17},
	doi = {10.1109/ICOSEC67334.2025.11459577},
	url = {https://www.scopus.com/pages/publications/105037155007?origin=resultslist},
	affiliations = {Student Vardhaman College Of Engineering, Department Of Eee, Hyderabad, India; Vardhaman College Of Engineering, Department Of Eee, Hyderabad, India},
	abstract = {The "Safety Auto Brake System for Hilly Region"is intended to increase vehicle safety in hilly terrains with steep hills and instability. The system incorporates a MEMS based accelerometer and gyroscope connected to a NodeMCU microcontroller to manage real-time monitoring of the vehicle's orientation and movement. In the event of abnormal tilting, acceleration or a potential collision, the system will deploy the braking system using an L293D motor driver and 300 RPM DC motors. Additionally, an LED will illuminate to notify the user of engagement of the braking system. The intention of this fully automated braking system intends to lessen accidents in hilly terrains with a timely and accurate response to risk. The whole system is powered using a stable power supply circuit with a 9V battery, bridge rectifier, filter capacitor and distributor.  © 2025 IEEE.},
