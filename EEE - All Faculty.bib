	title = {Solar photovoltaic converter controller using opposition-based reinforcement learning with butterfly optimization algorithm under partial shading conditions},
	year = {2023},
	journal = {Environmental Science and Pollution Research},
	volume = {30},
	number = {28},
	pages = {72617 - 72640},
	doi = {10.1007/s11356-023-27261-1},
