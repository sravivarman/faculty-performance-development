	author = {M, Deepak and Samithas, Devakirubakaran and Balachandran, Praveen Kumar and Selvarajan, Shitharth},
	title = {Experimental analysis of enhanced finite set model predictive control and direct torque control in SRM drives for torque ripple reduction},
	year = {2024},
	journal = {Scientific Reports},
	volume = {14},
	number = {1},
