	year = {2024},
	journal = {Proceedings of 5th International Conference on IoT Based Control Networks and Intelligent Systems, ICICNIS 2024},
	pages = {704 - 708},
	doi = {10.1109/ICICNIS64247.2024.10823230},
	url = {https://www.scopus.com/pages/publications/85217154035?origin=resultslist},
	affiliations = {Vardhaman College of Engineering, Dept. of EEE, Hyderabad, India; Hyderabad Institute of Technology and Management, Medchal, 501401, India},
	abstract = {A multi-phase multi-level converter is a sophisticated power electronics system designed to enhance energy conversion efficiency and performance in various applications. This converter utilizes a combination of multiple phases and voltage levels, introducing a more advanced approach compared to traditional converters. In practical terms, the converter distributes power across several phases, which can enhance system reliability and reduce the risk of failure. Each phase operates in tandem with others, contributing to a smoother overall power delivery. Simultaneously, the inclusion of multiple voltage levels allows for a finer control of the output waveform,lowering harmonic distortion and enhancing the power signal's quality. This technology finds significant applications in motor drives, renewable energy systems, and other areas where efficient energy conversion is crucial. By optimizing power distribution and voltage control, multi-phase multi-level converters contribute to more reliable and stable operation, making them integral components in modern power electronic systems. As energy efficiency and reliability continue to be paramount concerns, the development and utilization of these converters represent a key advancement in the field of power electronics.  © 2024 IEEE.},
