	title = {An optimized neural network-honey badger based control technique for a hybrid solar PV and battery energy storage fed unified power quality conditioner},
	year = {2025},
	journal = {Journal of Energy Storage},
	volume = {106},
	pages = {},
	doi = {10.1016/j.est.2024.114818},
	url = {https://www.scopus.com/pages/publications/85211061122?origin=resultslist},
	affiliations = {Electrical Engineering Department, College of Engineering, Najran University, Najran, 11001, Saudi Arabia; Department of Information Technology, R.V.R & J.C. College of Engineering, AP, Guntur, India; Department of Electrical and Electronics Engineering, Sreenidhi University, Telangana, Hyderabad, 501301, India; Department of Electrical, Electronic and Systems Engineering, Faculty of Engineering and Built Environment, Universiti Kebangsaan Malaysia, Selangor, Malaysia; Department of Electrical and Electronics Engineering, Chennai Institute of Technology, TN, Chennai, 600069, India; Department of Electrical and Electronics Engineering, Vardhaman College of Engineering, TS, Hyderabad, 501218, India; Department of Electrical and Electronics Engineering, Chaitanya Bharathi Institute of Technology, Hyderabad, 500075, India},
	abstract = {This work introduces a unified power quality conditioner (UPQC) powered by solar photovoltaic (PV) and battery energy storage systems designed to address power quality (PQ) issues. The Honey Badger Optimization Algorithm (HBOA) is employed to select optimal weights and bias of an artificial neural network (ANN), which is used for reference signal generation and direct current (DC) capacitor voltage regulation. This control strategy is proposed to generate reference signals for reduced-switch five-level converters of UPQC, eliminating the need for conventional transformations like instantaneous power (p-q) and synchronous reference frame (SRF) approaches. In addition, HBOA is applied to select the optimal parameters of shunt and series filters. The primary goals of this optimized UPQC approach are to minimize the total harmonic distortion (THD), enhance the power factor (PF), mitigate voltage disturbances like flicker, sag, swell, and unbalances, and stabilize the DC bus capacitor voltage during sun irradiation and load changes. The developed method is validated by four test cases involving different load and irradiation conditions. Moreover, a comparison with standard approaches like p-q, SRF theory, and optimization methods such as Genetic Algorithm (GA) and Particle Swarm Optimization (PSO) demonstrates the superiority of the developed approach. The solution effectively reduces voltage distortions and THD while improving the power factor, achieving THD reductions of 1.73 %, 1.44 %, 1.68 %, and 1.18 %. © 2024 Elsevier Ltd},
	author_keywords = {Battery energy storage; Honey badger optimization; Reduced switch voltage source converter; Solar PV system; Unified power quality conditioner},
