	keywords = {Battery management systems; Cobalt compounds; Forecasting; Life cycle; Lithium compounds; Operating costs; Secondary batteries; Statistics; Battery; Battery life; Electric vehicle batteries; Machine learning approaches; Machine-learning; Prediction modelling; Regression; Remaining useful life predictions; Remaining useful lives; Sustainable transportation; Machine learning},
